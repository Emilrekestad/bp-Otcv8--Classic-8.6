# Build artifacts (MSVC intermediate/output, vcpkg dependency builds)
vc17/otclient/
vcpkg_installed/
*.pdb
*.exp
*.lib
*.ilk

# Dev/test session logs
*.log

# Real Tibia client assets (Tibia.spr/.dat) - copyrighted CipSoft content,
# also far over GitHub's 100MB limit (Tibia.spr alone is ~430MB).
# Distributed separately, not part of source control.
data/things/

# Local minimap cache from testing - regenerated per install, not source.
data/minimap.otmm

# Security audit 2026-10-05 (BackpackOT docs/security/SECRETS_INVENTORY.md).
# This repository is PUBLIC. Nothing here holds a credential, but these keep
# dated binary backups, local client settings (encrypted saved passwords live
# in config.otml), and key files out of history.
*.bak-*
*.bak_*
*.bak
config.otml
hotkeys*.otml
.env
.env.*
*.pem
*.key
